<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /luxe-haven/

  # If the request is for a real file or directory, serve it directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # For any other request, send it to index.html (React Router handles it)
  RewriteRule ^ index.html [L]
</IfModule>

# Optional: Disable directory indexing for security
Options -Indexes

# Optional: Set default charset to UTF-8
AddDefaultCharset UTF-8
